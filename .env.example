# Claude AI Configuration
CLAUDE_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=2000

# Application Settings
DEFAULT_LANGUAGE=hi
SUPPORTED_LANGUAGES=hi,en,sa

# Performance & Limits
MAX_STORY_LENGTH=5000
MAX_PROJECT_SIZE=500
MAX_VIDEO_DURATION=600
MIN_VIDEO_DURATION=180
AUTO_SAVE_INTERVAL=30000
RENDER_TIMEOUT=600000

# Quality & Encoding
DEFAULT_RESOLUTION=1080
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_FPS=30
DEFAULT_BITRATE=10000000

# Memory & Optimization
MIN_MEMORY_THRESHOLD=104857600
MAX_MEMORY_USAGE=314572800
CACHE_CLEANUP_INTERVAL=3600000
ENABLE_MEMORY_OPTIMIZATION=true

# Features & Flags
ENABLE_AI_VOICE=true
ENABLE_SUBTITLE_GEN=true
ENABLE_SAFETY_CHECK=true
ENABLE_SELF_HEALING=true
ENABLE_AUTO_SAVE=true
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Logging
LOG_LEVEL=INFO
MAX_LOGS=1000

# API Configuration
API_REQUEST_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000
